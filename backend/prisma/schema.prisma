generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/client1"
  previewFeatures = ["multiSchema"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["crud_facturas"]
}

model Compania {
  id  Int     @default(autoincrement())
  cia String? @db.VarChar

  @@unique([id])
  @@map("T_Cias")
  @@schema("crud_facturas")
}

model Factura {
  id                      Int       @id(map: "t_facturas_pkey") @default(autoincrement())
  numeroControl           String    @unique(map: "uk_numero_control") @map("numero_control") @db.VarChar(50)
  cia                     String    @db.VarChar(2)
  ciaNit                  String    @map("cia_nit") @db.VarChar(50)
  nit                     String    @db.VarChar(20)
  proveedor               String    @db.VarChar(255)
  numeroFactura           String    @map("numero_factura") @db.VarChar(50)
  fechaRadicado           DateTime  @map("fecha_radicado") @db.Date
  fechaFactura            DateTime  @map("fecha_factura") @db.Date
  facturaCredito          String    @map("factura_credito") @db.VarChar(2)
  acuseReciboSCI          String    @map("acuse_recibo_sci") @db.VarChar(2)
  legalizaAnticipo        String    @default("No") @map("legaliza_anticipo") @db.VarChar(2)
  entregadaA              String    @map("entregada_a") @db.VarChar(255)
  fechaEntrega            DateTime  @map("fecha_entrega") @db.Date
  fechaRecepcionCausacion DateTime? @map("fecha_recepcion_causacion") @db.Date
  recibidaPor             String?   @map("recibida_por") @db.VarChar(255)
  fechaRevisionCausacion  DateTime? @map("fecha_revision_causacion") @db.Date
  numeroCausacion         String?   @map("numero_causacion") @db.VarChar(50)
  fechaCausacion          DateTime? @map("fecha_causacion") @db.Date
  observaciones           String?   @db.VarChar(50)
  creadoEn                DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  actualizadoEn           DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([cia], map: "idx_facturas_cia")
  @@index([nit], map: "idx_facturas_nit")
  @@index([numeroControl], map: "idx_facturas_numero_control")
  @@map("T_Facturas")
  @@schema("crud_facturas")
}

model Persona {
  id     Int     @default(autoincrement())
  nombre String? @db.VarChar
  correo String? @db.VarChar

  @@unique([id])
  @@map("T_Personas")
  @@schema("crud_facturas")
}
