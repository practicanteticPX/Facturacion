generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/client1"
  previewFeatures = ["multiSchema", "driverAdapters"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["crud_facturas"]
}

model CentroCosto {
  id          Int     @id @default(autoincrement())
  centroCosto String? @map("CentroCosto") @db.VarChar(255)
  ciaCC       String? @map("Cia_CC") @db.VarChar(50)
  responsable String? @map("Responsable") @db.VarChar(255)

  @@map("T_CentrosCostos")
  @@schema("crud_facturas")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model Compania {
  id  Int     @default(autoincrement())
  cia String? @db.VarChar

  @@map("T_Cias")
  @@ignore
  @@schema("crud_facturas")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model Factura {
  numeroControl          Int       @id(map: "t_facturas_pkey") @default(autoincrement()) @map("numero_control")
  cia                    String?   @db.VarChar(2)
  ciaNit                 String?   @map("cia_nit") @db.VarChar(50)
  nit                    String?   @db.VarChar(50)
  proveedor              String?   @db.VarChar(100)
  numeroFactura          String?   @map("numero_factura") @db.VarChar(50)
  fechaRadicado          DateTime? @map("fecha_radicado") @db.Date
  fechaFactura           DateTime? @map("fecha_factura") @db.Date
  facturaCredito         Boolean?  @map("factura_credito")
  acuseReciboSCI         Boolean?  @map("acuse_recibo_sci")
  entregadaA             String?   @map("entregada_a") @db.VarChar(50)
  fechaEntrega           DateTime? @map("fecha_entrega") @db.Date
  numeroCausacion        String?   @map("numero_causacion") @db.VarChar(50)
  fechaCausacion         DateTime? @map("fecha_causacion") @db.Date
  observaciones          String?   @db.VarChar(500)
  observacionesCausacion String?   @map("observaciones_causacion") @db.VarChar(500)
  causadoPor             String?   @map("causado_por") @db.VarChar(100)
  rechazada              Boolean?  @default(false) @map("rechazada")
  corregida              Boolean?  @default(false) @map("corregida")
  creadoEn               DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  actualizadoEn          DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)
  enProceso              Boolean?  @default(false) @map("en_proceso")
  finalizado             Boolean?  @default(false) @map("finalizado")
  causado                Boolean?  @default(false) @map("causado")

  @@index([cia], map: "idx_facturas_cia")
  @@index([nit], map: "idx_facturas_nit")
  @@index([numeroControl], map: "idx_numero_control")
  @@map("T_Facturas")
  @@schema("crud_facturas")
}

model Negociador {
  id         Int     @id @default(autoincrement())
  negociador String? @db.VarChar(255)
  cargo      String? @db.VarChar(255)

  @@map("T_Negociadores")
  @@schema("crud_facturas")
}

model Persona {
  id     Int     @id @default(autoincrement())
  nombre String? @db.VarChar(255)
  correo String? @db.VarChar(255)
  cargo  String? @db.VarChar(255)

  @@map("T_Personas")
  @@schema("crud_facturas")
}
