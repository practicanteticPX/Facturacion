# Conexión a la base de datos SERV_QPREX (ESCRITURA - donde se guardan las facturas y se obtienen los colaboradores)
DATABASE_URL="postgresql://usuario:password@host:5432/SERV_QPREX"

# Conexión a la base de datos DB_QPREX (SOLO LECTURA - para consultar proveedores)
DATABASE_URL_2="postgresql://usuario:password@host:5432/DB_QPREX"

# Puerto del backend
PORT=4000

# URL del frontend (para CORS)
FRONTEND_URL=http://localhost:3000

# Configuración SMTP
SMTP_HOST=mail.ejemplo.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=usuario@ejemplo.com
SMTP_PASS=tu_password
SMTP_FROM_NAME=Nombre del Remitente
SMTP_FROM_EMAIL=correo@ejemplo.com
