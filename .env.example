# ============================================
# CONFIGURACIÓN DE BASE DE DATOS
# ============================================

# Conexión a la base de datos SERV_QPREX (ESCRITURA - donde se guardan las facturas y se obtienen los colaboradores)
DATABASE_URL="postgresql://usuario:contraseña@IP_BASE_DATOS:5432/SERV_QPREX"

# Conexión a la base de datos DB_QPREX (SOLO LECTURA - para consultar proveedores)
DATABASE_URL_2="postgresql://usuario:contraseña@IP_BASE_DATOS:5432/DB_QPREX"

# ============================================
# CONFIGURACIÓN DE SERVIDOR
# ============================================

# Puerto del backend
PORT=4000

# URL del frontend (para CORS)
# Para desarrollo local: http://localhost:3000
# Para red local: http://<TU_IP_LOCAL>:3000
FRONTEND_URL=http://localhost:3000

# ============================================
# CONFIGURACIÓN DE RED LOCAL
# ============================================

# URL del backend GraphQL para el frontend
#
# OPCIÓN 1 - SOLO ACCESO LOCAL (mismo equipo):
# REACT_APP_GRAPHQL_URL=http://localhost:4000/graphql
#
# OPCIÓN 2 - ACCESO DESDE RED LOCAL (otros equipos):
# REACT_APP_GRAPHQL_URL=http://<TU_IP_LOCAL>:4000/graphql
#
# Ejemplo para red local:
# REACT_APP_GRAPHQL_URL=http://192.168.0.100:4000/graphql
#
# Para obtener tu IP local:
# Windows: ipconfig (buscar "Dirección IPv4")
# Linux/Mac: ifconfig o ip addr (buscar inet)
REACT_APP_GRAPHQL_URL=http://localhost:4000/graphql

# ============================================
# CONFIGURACIÓN ACTIVE DIRECTORY
# ============================================

# Configuración Active Directory para autenticación
AD_PROTOCOL=ldap
AD_HOSTNAME=192.168.0.253
AD_PORT=389
AD_BASE_DN=DC=prexxa,DC=local
AD_SEARCH_BASE=DC=prexxa,DC=local
AD_BIND_USER=usuario.servicio@dominio.local
AD_BIND_PASS=contraseña_servicio

# IMPORTANTE: Solo usuarios con "Ad y Finan" en el campo Descripción pueden autenticarse

# ============================================
# CONFIGURACIÓN JWT
# ============================================

# Secret para firmar tokens JWT (CAMBIAR EN PRODUCCIÓN - usar un valor aleatorio fuerte)
JWT_SECRET=tu-secret-super-seguro-cambiar-en-produccion
# Tiempo de expiración del token (8 horas)
JWT_EXPIRES_IN=8h
